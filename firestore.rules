rules_version = '2';

// SocietySarv - Cloud Firestore Security Rules
// Database: societysarv-app-db (project: multisarv-mobileapps)
//
// NOTE ON AUTH:
//   The app calls Firebase Anonymous Auth on startup. Once the Anonymous
//   provider is switched on in
//   Firebase Console > Authentication > Sign-in method > Anonymous,
//   deploy `firestore.rules.secure` (see README-FIREBASE.md) so every request
//   must carry an authenticated identity. Until then these rules stay open so
//   that the app keeps working.
//
// Writes are split into create/update (payload is validated) and delete
// (`request.resource` is null on a delete, so it must not be inspected there).

service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return true; // -> change to `request.auth != null` once Anonymous Auth is ON
    }

    function has(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Every society is one document keyed by its login code, and all of its
    // records live in subcollections underneath it. Two societies can never
    // read or write each other's data because the paths do not overlap.
    match /societies/{societyCode} {
      allow read: if allowed();
      allow create, update: if allowed()
        && request.resource.data.name is string
        && request.resource.data.societyCode is string
        && request.resource.data.currentBalanceCash is number
        && request.resource.data.currentBalanceBank is number;
      allow delete: if allowed();

      match /residents/{flatNumber} {
        allow read: if allowed();
        allow create, update: if allowed()
          && has(['flatNumber', 'ownerName', 'pin', 'role'])
          && request.resource.data.flatNumber is string
          && request.resource.data.ownerName is string
          && request.resource.data.pin is string;
        allow delete: if allowed();
      }

      match /maintenance_bills/{billId} {
        allow read: if allowed();
        allow create, update: if allowed()
          && has(['flatNumber', 'totalAmount', 'status'])
          && request.resource.data.totalAmount is number
          && request.resource.data.amountPaid is number;
        allow delete: if allowed();
      }

      match /expense_records/{expenseId} {
        allow read: if allowed();
        allow create, update: if allowed()
          && has(['title', 'amount', 'category'])
          && request.resource.data.amount is number;
        allow delete: if allowed();
      }

      match /non_fee_revenues/{revenueId} {
        allow read: if allowed();
        allow create, update: if allowed()
          && has(['title', 'amount', 'sourceCategory'])
          && request.resource.data.amount is number;
        allow delete: if allowed();
      }

      match /visitor_logs/{visitorId} {
        allow read: if allowed();
        allow create, update: if allowed()
          && has(['visitorName', 'flatNumber', 'status']);
        allow delete: if allowed();
      }

      match /notices/{noticeId} {
        allow read: if allowed();
        allow create, update: if allowed()
          && has(['title', 'content']);
        allow delete: if allowed();
      }

      match /complaints/{complaintId} {
        allow read: if allowed();
        allow create, update: if allowed()
          && has(['flatNumber', 'description', 'status']);
        allow delete: if allowed();
      }

      match /emergency_contacts/{contactId} {
        allow read: if allowed();
        allow create, update: if allowed()
          && has(['name', 'phoneNumber']);
        allow delete: if allowed();
      }

      // Per-society auto-increment counters, so ids restart at 1 per society.
      match /counters/{counterId} {
        allow read: if allowed();
        allow create, update: if allowed() && request.resource.data.value is int;
        allow delete: if allowed();
      }
    }

    // Outgoing email, picked up by the Trigger Email extension. The app may
    // queue a message and read back whether it was delivered, but never edit
    // or remove one - a sent mail is a record.
    match /mail/{mailId} {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.to is list
        && request.resource.data.message.subject is string;
      allow update, delete: if false;
    }

    // ---- Everything else is denied ---------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
